<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 900" role="img" aria-labelledby="title desc"><title id="title">Inside the Sun</title><desc id="desc">A schematic cross-section and numbered key identify the core, radiative zone, convection zone and visible surface. Energy takes a very long time to travel outward.</desc><defs><radialGradient id="sun" cx="35%" cy="30%"><stop stop-color="#ffe49b"/><stop offset="1" stop-color="#d86a30"/></radialGradient><radialGradient id="rad" cx="35%" cy="30%"><stop stop-color="#fff3be"/><stop offset="1" stop-color="#f4ab50"/></radialGradient><marker id="a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="#a34b20"/></marker></defs>
