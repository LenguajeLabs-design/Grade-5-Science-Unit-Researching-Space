.space-hub-bar{box-sizing:border-box;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 20px;background:#e9f2ed;color:#132b26;padding:12px 22px;font:14px/1.5 Arial,Helvetica,sans-serif;border-bottom:1px solid #c4d4cb;position:relative;z-index:1}.space-hub-bar a{display:inline-block;color:#174d42;text-decoration:none;padding:6px 3px;min-height:36px;font-weight:600;letter-spacing:normal}.space-hub-bar a:hover{text-decoration:underline}.space-hub-bar a:focus-visible{outline:3px solid #146b5b;outline-offset:2px}.space-hub-bar .space-hub-home{font-weight:800;white-space:nowrap}.space-hub-links{display:flex;gap:8px 18px;flex-wrap:wrap}.space-hub-links a[aria-current=page]{text-decoration:underline;text-underline-offset:5px;color:#101d39}@media(max-width:650px){.space-hub-bar{padding:10px 16px;font-size:12px}.space-hub-links{gap:4px 13px}}@media print{.space-hub-bar{display:none!important}}
