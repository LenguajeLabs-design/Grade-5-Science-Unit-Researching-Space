<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 550" role="img" aria-labelledby="title description">
  <title id="title">Inside the Sun: where energy begins</title>
  <desc id="description">A schematic cross-section shows the core surrounded by the radiative zone and convection zone, then the thin visible surface. Fusion releases energy in the core. Energy moves outward through the Sun over a very long time; light leaves the visible surface.</desc>
  <defs>
    <radialGradient id="outer" cx="37%" cy="32%" r="70%"><stop offset="0" stop-color="#ffd47a"/><stop offset=".68" stop-color="#f49c3e"/><stop offset="1" stop-color="#cf562b"/></radialGradient>
    <radialGradient id="middle" cx="38%" cy="32%" r="68%"><stop stop-color="#fff2b5"/><stop offset=".7" stop-color="#ffc769"/><stop offset="1" stop-color="#ea8839"/></radialGradient>
    <radialGradient id="core" cx="40%" cy="34%"><stop stop-color="#fffbe0"/><stop offset="1" stop-color="#ffe28b"/></radialGradient>
    <pattern id="grain" width="23" height="23" patternUnits="userSpaceOnUse"><path d="M2 14c3-6 8-8 12-5m1 8c2-3 5-4 7-4" fill="none" stroke="#a94326" stroke-width="1.2" opacity=".18"/></pattern>
    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 10 5 0 10z" fill="#a34b20"/></marker>
  </defs>
  <rect x="1" y="1" width="1198" height="548" rx="22" fill="#fffaf1" stroke="#e5d8c4" stroke-width="2"/>
  <g font-family="Arial,Helvetica,sans-serif">
    <text x="42" y="50" fill="#a1461e" font-size="19" font-weight="700" letter-spacing="2">SCIENCE SPOTLIGHT / THE SUN'S INTERIOR</text>
    <text x="42" y="83" fill="#1b2b43" font-size="27" font-weight="700">A long journey outward</text>
    <line x1="42" y1="101" x2="1158" y2="101" stroke="#e4d6c1" stroke-width="2"/>
    <!-- Cross-section: nested regions are schematic, with a separate thin photosphere rim. -->
    <circle cx="244" cy="285" r="168" fill="url(#outer)" stroke="#b6532c" stroke-width="2"/>
    <circle cx="244" cy="285" r="166" fill="url(#grain)"/>
    <circle cx="244" cy="285" r="119" fill="url(#middle)" stroke="#bf672f" stroke-width="1.5"/>
    <circle cx="244" cy="285" r="56" fill="url(#core)" stroke="#ca8442" stroke-width="1.5"/>
    <circle cx="244" cy="285" r="167" fill="none" stroke="#fff0ca" stroke-width="5"/>
    <path d="M266 319 C275 310 283 321 294 315 S310 308 320 315 S339 320 348 313 S365 306 374 312 S389 314 395 310" fill="none" stroke="#a34b20" stroke-width="3" stroke-linecap="round" marker-end="url(#arrow)"/>
    <text x="244" y="276" text-anchor="middle" font-size="18" fill="#733c21" font-weight="700">CORE</text>
    <text x="244" y="296" text-anchor="middle" font-size="13" fill="#733c21">fusion</text>
    <!-- Leader endpoints lie in the respective regions, deliberately offset so they do not cross. -->
    <g fill="none" stroke="#657384" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M260 244 L427 151 L487 151"/>
      <path d="M322 229 L427 229 L487 229"/>
      <path d="M389 282 L427 307 L487 307"/>
      <path d="M386 373 L427 385 L487 385"/>
    </g>
    <g fill="#fffaf1" stroke="#526477" stroke-width="2"><circle cx="260" cy="244" r="4"/><circle cx="322" cy="229" r="4"/><circle cx="389" cy="282" r="4"/><circle cx="386" cy="373" r="4"/></g>
    <g fill="#a1461e" font-size="15" font-weight="700" letter-spacing="1"><text x="504" y="147">01</text><text x="504" y="225">02</text><text x="504" y="303">03</text><text x="504" y="381">04</text></g>
    <g fill="#1b2b43"><text x="542" y="148" font-size="24" font-weight="700">Core</text><text x="542" y="175" font-size="20">Hydrogen nuclei fuse and release energy.</text>
      <text x="542" y="226" font-size="24" font-weight="700">Radiative zone</text><text x="542" y="253" font-size="20">Energy moves outward through radiation.</text>
      <text x="542" y="304" font-size="24" font-weight="700">Convection zone</text><text x="542" y="331" font-size="20">Moving hot material carries energy outward.</text>
      <text x="542" y="382" font-size="24" font-weight="700">Visible surface / photosphere</text><text x="542" y="409" font-size="20">Light escapes into space from this layer.</text></g>
    <rect x="42" y="459" width="1116" height="58" rx="9" fill="#f7e4be"/>
    <text x="63" y="484" fill="#6d3619" font-size="18" font-weight="700">TIME MATTERS</text><text x="215" y="484" fill="#24334a" font-size="18">Energy takes a very long time to travel from the core to the surface.</text>
    <text x="63" y="505" fill="#526273" font-size="18">Schematic cutaway: colors and layer widths are not to scale.</text>
  </g>
</svg>
